# Copie para .env e preencha só na sua máquina. Não commite o .env.

# Senha do Postgres local, lida pelo docker compose. Não coloque um valor aqui.
POSTGRES_PASSWORD=

# Segredo que assina o cookie de sessão. Use um valor longo e aleatório.
# Se ficar vazio no desenvolvimento, o sistema gera um arquivo em .data, fora do Git.
SESSAO_SEGREDO=

# Opcional. Sem DATABASE_URL o sistema usa o Postgres local em memória (PGlite).
# DATABASE_URL=
